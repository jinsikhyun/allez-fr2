        {"table": [["", "venir 오다", "devenir ~이 되다"], ["je", "viens", "deviens"], ["tu", "viens", "deviens"], ["il/elle", "vient", "devient"], ["nous", "venons", "devenons"], ["vous", "venez", "devenez"], ["ils/elles", "viennent", "deviennent"]], "head": true},
