            ["être", "je serai", "nous serons", "ils seront"],
            ["aller", "j'irai", "nous irons", "ils iront"],
            ["voir", "je verrai", "nous verrons", "ils verront"],
            ["faire", "je ferai", "nous ferons", "ils feront"],
            ["savoir", "je saurai", "nous saurons", "ils sauront"],
            ["vouloir", "je voudrai", "nous voudrons", "ils voudront"],
