  "tips": [
    { "h": "반과거 만드는 법", "b": "nous 현재형 − **-ons** + **-ais · -ais · -ait · -ions · -iez · -aient**\nnous parlons → parl- → je parlais" },
    { "h": "어간 한눈에", "rows": [["parler (nous parlons)", "parl-"], ["avoir (nous avons)", "av-"], ["faire (nous faisons)", "fais-"], ["prendre (nous prenons)", "pren-"], ["⚠️ être (예외)", "ét-"]] },
